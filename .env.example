# ==============================================================================
# SIDAK ENVIRONMENT CONFIGURATION (TEMPLATE)
# Salin file ini ke .env untuk konfigurasi lokal: cp .env.example .env
# ==============================================================================

# APP & SERVER
APP_ENV=development
APP_PORT=8080
APP_SECRET=supersecretjwtkey_min_32_characters_long_sidak_2026

# DATABASE (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sidak_db
DB_SSLMODE=disable

# CLOUDFLARE R2 (S3 Compatible Protocol)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=sidak-storage
R2_PUBLIC_URL=https://cdn.kelurahan.go.id

# GOTENBERG PDF ENGINE (Fase 3)
GOTENBERG_URL=http://localhost:3000

# WEB CLIENT URLS
WEB_PUBLIC_URL=http://localhost:3001
WEB_ADMIN_URL=http://localhost:3001/admin
