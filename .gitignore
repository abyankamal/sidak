# ==============================================================================
# SIDAK MONOREPO .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: JANGAN PERNAH DI-PUSH)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.p12
*.jks
*.keystore
secrets/
credentials/

# ------------------------------------------------------------------------------
# 2. OS & IDE System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 3. Backend (Golang & PostgreSQL)
# ------------------------------------------------------------------------------
backend/bin/
backend/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
*.coverprofile
/server
/main
/app
backend/vendor/

# Database dumps & local sqlite
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# 4. Web (Next.js App Router)
# ------------------------------------------------------------------------------
web/node_modules/
web/.next/
web/out/
web/build/
web/dist/
web/.turbo/
web/.vercel/
web/*.tsbuildinfo
web/next-env.d.ts.bak

# Logs & Package Manager Artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Mobile (Flutter Offline-First)
# ------------------------------------------------------------------------------
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub/
mobile/.pub-cache/
mobile/build/

# CRITICAL PII: Local Offline Staging Area (KTP, KK, Berkas Warga)
mobile/offline_staging/
offline_staging/
*/offline_staging/

# Android Specific
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/android/captures/
mobile/android/.cxx/
mobile/android/app/google-services.json

# iOS Specific
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Flutter/App.framework
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/profile
mobile/ios/DerivedData/
mobile/ios/Runner/GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 6. Deployment & Infrastructure
# ------------------------------------------------------------------------------
deploy/data/
deploy/postgres_data/
deploy/caddy_data/
deploy/caddy_config/
deploy/backups/
*.tar.gz
*.zip
